# How to run FormFlow AI
#
# DEMO MODE (default, free, no key needed):
#   LLM_PROVIDER=mock
#
# GO LIVE with Google:
#   LLM_PROVIDER=gemini
#   GEMINI_API_KEY=your-key-here
#
# GO LIVE with OpenAI:
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY=your-key-here
#
# Copy this file to .env.local and fill in what you need.
# .env.local is git-ignored, so keys never leave your machine.

LLM_PROVIDER=mock
# GEMINI_API_KEY=
# OPENAI_API_KEY=
